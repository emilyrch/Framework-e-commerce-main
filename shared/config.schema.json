{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "store_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 40,
      "pattern": "^[a-z0-9-]+$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "domain": {
      "enum": [
        "clothing",
        "food"
      ]
    },
    "currency": {
      "const": "BRL"
    },
    "timezone": {
      "const": "America/Sao_Paulo"
    },
    "features": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^demo-data/[a-zA-Z0-9_./-]+[.]json$"
        }
      },
      "required": [
        "dataset_id",
        "schema_version",
        "source"
      ]
    },
    "delivery": {},
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "simulated_pix"
        },
        "discount_cents": {
          "type": "integer",
          "const": 0
        }
      },
      "required": [
        "provider",
        "discount_cents"
      ]
    }
  },
  "required": [
    "schema_version",
    "store_id",
    "display_name",
    "domain",
    "currency",
    "timezone",
    "features",
    "catalog",
    "delivery",
    "payment"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "domain": {
            "const": "clothing"
          }
        }
      },
      "then": {
        "properties": {
          "features": {
            "minItems": 7,
            "maxItems": 7,
            "items": {
              "enum": [
                "catalog",
                "cart",
                "checkout",
                "orders",
                "simulated_pix",
                "address_delivery",
                "size_color_selection"
              ]
            }
          },
          "delivery": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "policy": {
                "const": "unscheduled"
              },
              "shipping_cents": {
                "type": "integer",
                "const": 0
              }
            },
            "required": [
              "policy",
              "shipping_cents"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "domain": {
            "const": "food"
          }
        }
      },
      "then": {
        "properties": {
          "features": {
            "minItems": 8,
            "maxItems": 8,
            "items": {
              "enum": [
                "catalog",
                "cart",
                "checkout",
                "orders",
                "simulated_pix",
                "address_delivery",
                "food_information",
                "delivery_scheduling"
              ]
            }
          },
          "delivery": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "policy": {
                "const": "scheduled"
              },
              "shipping_cents": {
                "type": "integer",
                "const": 0
              },
              "schedule": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "policy_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "pattern": "^[a-z0-9][a-z0-9-]*$"
                  },
                  "days_ahead": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 7
                  },
                  "daily_windows": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 24,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80,
                          "pattern": "^[a-z0-9][a-z0-9-]*$"
                        },
                        "start": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80,
                          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                        },
                        "end": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80,
                          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                        },
                        "enabled": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "id",
                        "start",
                        "end",
                        "enabled"
                      ]
                    }
                  }
                },
                "required": [
                  "policy_id",
                  "days_ahead",
                  "daily_windows"
                ]
              }
            },
            "required": [
              "policy",
              "shipping_cents",
              "schedule"
            ]
          }
        }
      }
    }
  ]
}
